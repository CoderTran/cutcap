{
  "name": "cutcap",
  "productName": "Cutcap",
  "version": "0.2.0",
  "description": "Phần mềm chỉnh sửa video cho Windows – dễ dùng, xuất nhanh",
  "license": "GPL-3.0-or-later",
  "author": "Cutcap contributors",
  "main": "./out/main/index.js",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:ffmpeg": "node scripts/setup-ffmpeg.mjs",
    "icons": "node scripts/make-icons.mjs",
    "dist": "node scripts/dist.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "i18next": "^26.4.7",
    "immer": "^11.1.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.19",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  }
}
